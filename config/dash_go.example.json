{
  "listen": ":8750",
  "base_path": "/dash_go",
  "log_dir": "logs",
  "dash_home": "/ie/",
  "dash_config_dir": "C:\\path\\to\\dash\\config",
  "session_hours": 12,
  "photo_url_template": "/api/static/hr/{ee_code}.webp",
  "login_password": true,
  "sso_require_same_ip": true,
  "trusted_proxies": ["127.0.0.1", "::1"],
  "update_url": "",
  "update_interval_minutes": 10,
  "update_restart": "supervise",
  "modules": {
    "hc_scan": {
      "employee_id_pattern": "[A-Z]{2,3}\\d{2}[A-Z0-9]\\d{2}",
      "draft_store": "redis",
      "recent_days": 7,
      "dash_data_dir": "C:\\path\\to\\dash\\data",
      "leader_by_history": true
    }
  }
}
