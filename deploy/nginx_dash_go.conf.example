# dash_go behind nginx.
#
# Add this location inside the server { } block that already serves /ie and /api (server s2). The service
# serves everything below /dash_go/ itself, so the prefix is passed through and must not be stripped:
# proxy_pass has no URI part on purpose. The port is the "listen" setting of dash_go.json.
#
# Reload nginx after the change: nginx -s reload

location /dash_go/ {
    proxy_pass http://127.0.0.1:8750;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}
